# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it is git-ignored.

# --- Required -----------------------------------------------------------------
# JWT signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
MONGO_URI=mongodb://localhost:27017
FLASK_ENV=development            # development | production | testing

# --- Bootstrap administrator --------------------------------------------------
# Admin login is disabled while either value is empty. Use a long, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Language model (Groq) ------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30

# --- Vector database (Pinecone, serverless index) -------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=student-chatbot
PINECONE_NAMESPACE=course_materials
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Document storage (Cloudinary) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PDF_FOLDER=student_chatbot/pdfs
# authenticated = private files reached through signed URLs (recommended)
# upload        = public files (old behaviour)
CLOUDINARY_DELIVERY_TYPE=authenticated

# --- Email (SMTP) ------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASS=

# --- Web / security ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API ('*' is rejected).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the app (0 when running locally).
TRUST_PROXY_HOPS=0
MAX_UPLOAD_MB=10
QUERY_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
# Admin-only diagnostic endpoints; never available when FLASK_ENV=production.
ENABLE_DEBUG_ROUTES=false

# --- Optional: LangSmith tracing (sends prompts and questions to LangSmith) -----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
