# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it is git-ignored.

# --- Required -----------------------------------------------------------------
# JWT signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# MongoDB Atlas: copy the connection string from Atlas > Connect > Drivers and replace
# <db_password> with the database user's password (URL-encode @ : / ? # if present).
# Also allow this machine's IP address in Atlas > Network Access.
# Check it with:  python -m tools.connection_check
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chatbot
FLASK_ENV=development            # development | production | testing

# --- Staff accounts and sessions --------------------------------------------------
# Optional bootstrap Super Administrator (disabled while either value is empty). Recommended
# instead: create a real Super Administrator account once with
#   python -m tools.create_staff --email you@usiu.ac.ke --name "Your Name" --role super_admin
# and leave these empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Staff dashboard sessions expire after this many hours (all roles).
ADMIN_TOKEN_HOURS=8
# Failed sign-ins before an account is locked, and for how many minutes.
STAFF_MAX_FAILED_LOGINS=5
STAFF_LOCKOUT_MINUTES=15
STAFF_BCRYPT_ROUNDS=12

# --- Language model (Groq) ------------------------------------------------------
GROQ_API_KEY=
# llama-3.3-70b-versatile is no longer offered by Groq to this project's key (checked 2026-11-02).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30
# Reasoning models (openai/gpt-oss-*) spend part of the token budget on hidden reasoning.
# Empty = "low" for gpt-oss (fast, leaves room for the answer); low | medium | high | default.
GROQ_REASONING_EFFORT=
GROQ_MAX_TOKENS=2048

# --- Approved sources and local retrieval (chat answers) -------------------------
# Source and citation URLs must be https on one of these domains (subdomains included).
ALLOWED_SOURCE_DOMAINS=usiu.ac.ke
# Sources older than this (by their own date, else the date they were copied) get a warning.
SOURCE_STALE_DAYS=365
# Out-of-date sources rank as if this much less relevant (0-1; 1 = no preference for current sources).
SOURCE_STALE_PENALTY=0.85
SOURCE_MAX_TEXT_CHARS=200000
# Sources per question, whole sections up to this size, and the total context size (characters).
# Larger contexts give fuller answers but use more Groq tokens per question (check your tokens-per-minute limit).
SOURCE_CONTEXT_COUNT=6
SOURCE_FULL_SECTION_CHARS=6000
SOURCE_CONTEXT_MAX_CHARS=12000
# Sources of the department a question is about rank this many times higher (1 = off).
SOURCE_DEPARTMENT_BOOST=1.5
RETRIEVAL_MIN_SCORE=0.5
RETRIEVAL_MIN_COVERAGE=0.5
SOURCE_INDEX_TTL=60
# External bodies (e.g. KUCCPS) whose dataset records may be cited; always labelled "not USIU-Africa policy".
# Must not include an official USIU-Africa domain. Leave empty to refuse external records.
EXTERNAL_SOURCE_DOMAINS=kuccps.net,cue.or.ke,knqa.go.ke
# The completed USIUBOT dataset (default: ../usiubot_datasets). Imported as drafts only.
DATASET_DIR=

# --- Live retrieval of official pages (off by default) ---------------------------
# Enable only after `python -m tools.live_check` succeeds from the deployment host.
# robots.txt is always obeyed: a page it disallows is never fetched.
LIVE_RETRIEVAL_ENABLED=false
# Exact host names (comma-separated). Subdomains are not trusted automatically;
# portal hosts such as cx.usiu.ac.ke are always refused.
TRUSTED_SOURCE_HOSTS=www.usiu.ac.ke
LIVE_USER_AGENT=USIUBOT/1.0
# Catalogue of candidate pages (URLs and metadata only). Default: config/official_pages.json
OFFICIAL_PAGES_FILE=
LIVE_CONNECT_TIMEOUT=5
LIVE_READ_TIMEOUT=10
LIVE_QUESTION_BUDGET_SECONDS=15
LIVE_MAX_PAGES_PER_QUESTION=3
LIVE_MAX_PAGE_KB=2000
# In-memory cache only (nothing is written to disk)
LIVE_PAGE_CACHE_SECONDS=86400
LIVE_ROBOTS_CACHE_SECONDS=86400
LIVE_FAILURE_CACHE_SECONDS=900
LIVE_CACHE_MAX_PAGES=200
LIVE_CACHE_MAX_MB=20
# "Unverified search" link (site:www.usiu.ac.ke), opened in the user's browser only
SITE_SEARCH_LINK_ENABLED=true

# --- Unresolved enquiries ----------------------------------------------------------
# Staff addresses notified of new enquiries (comma-separated, optional). Requires SMTP
# below. Enquiries are always listed in the admin dashboard either way. Use only addresses
# confirmed by the office concerned; none are pre-filled.
ENQUIRY_EMAIL_ADMISSIONS=
ENQUIRY_EMAIL_REGISTRAR=
ENQUIRY_EMAIL_MARKETING=
ENQUIRY_EMAIL_ACADEMIC_PROGRAMMES=
ENQUIRY_EMAIL_GENERAL_UNIVERSITY=
ENQUIRY_EMAIL_FINANCE=
ENQUIRY_EMAIL_STUDENT_AFFAIRS=
ENQUIRY_EMAIL_ICT=
ENQUIRY_EMAIL_LIBRARY=
# Addresses can also be set per department in the admin dashboard (Routing tab); those take precedence.
# Fallback links: share of a question's key words a suggested official page must match (0-1)
FALLBACK_LINK_MIN_COVERAGE=0.5
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
# Further notifications (sent only when SMTP below is configured; each attempt is recorded on the enquiry)
ENQUIRY_NOTIFY_ASSIGNEE=true      # email a staff member when an enquiry is assigned to them
ENQUIRY_NOTIFY_ENQUIRER=true      # email the enquirer the staff response / resolution
# python -m tools.enquiry_reminders: remind departments of enquiries without updates for N days
ENQUIRY_REMINDER_DAYS=3

# --- Degree guidance (results-slip upload; processed in memory, never stored) -------
GUIDANCE_MAX_UPLOAD_MB=5
GUIDANCE_RATE_LIMIT_PER_MINUTE=10

# --- Vector database (Pinecone, serverless index) — legacy PDF management only ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=student-chatbot
PINECONE_NAMESPACE=course_materials
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Document storage (Cloudinary) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PDF_FOLDER=student_chatbot/pdfs
# authenticated = private files reached through signed URLs (recommended)
# upload        = public files (old behaviour)
CLOUDINARY_DELIVERY_TYPE=authenticated

# --- Email (SMTP) ------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASS=

# --- Web / security ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API ('*' is rejected).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the app (0 when running locally).
TRUST_PROXY_HOPS=0
MAX_UPLOAD_MB=10
QUERY_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
# Admin-only diagnostic endpoints; never available when FLASK_ENV=production.
ENABLE_DEBUG_ROUTES=false

# --- Optional: LangSmith tracing (sends prompts and questions to LangSmith) -----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
