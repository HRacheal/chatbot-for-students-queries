# Copy to frontend/.env.local (git-ignored).
# Leave empty in development: Vite proxies /api to http://127.0.0.1:5000.
# In production, set it to the backend URL and add the frontend's origin to the
# backend's CORS_ORIGINS.
VITE_API_BASE_URL=
# Domains whose https links may be shown as citations (comma-separated).
VITE_ALLOWED_SOURCE_DOMAINS=usiu.ac.ke
# External bodies whose pages may be linked from citations labelled "External" (match the backend's
# EXTERNAL_SOURCE_DOMAINS).
VITE_EXTERNAL_SOURCE_DOMAINS=kuccps.net,cue.or.ke,knqa.go.ke
